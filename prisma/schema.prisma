// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  name           String?
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  /// Incrémenté pour invalider toutes les sessions JWT existantes (changement de mot de passe…).
  sessionVersion Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  cartItems           CartItem[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  productType    String?
  /// Code couleur (#rrggbb) de la pastille ; colorName est le libellé affiché.
  color          String?
  colorName      String?
  material       String?
  fit            String?
  care           String?
  priceCents     Int
  currency       String   @default("EUR")
  onSale         Boolean  @default(false)
  salePriceCents Int?
  images         String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sizes      ProductSize[]
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model ProductSize {
  id        String @id @default(cuid())
  productId String
  size      String
  stock     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id         String      @id @default(cuid())
  userId     String?
  status     OrderStatus @default(PENDING)
  totalCents Int
  currency   String      @default("EUR")

  customerName  String
  customerEmail String
  phone         String?

  shippingAddress    String
  shippingCity       String
  shippingPostalCode String
  shippingCountry    String @default("FR")

  /// Mode et méthode Sendcloud choisis au checkout : le tarif facturé en dépend
  /// et l'étiquette reprend la même méthode par défaut.
  deliveryMode       DeliveryMode @default(HOME)
  shippingMethodId   Int?
  shippingMethodName String?
  shippingCarrier    String?

  /// Point relais Sendcloud choisi par le client (mode SERVICE_POINT).
  servicePointId         Int?
  servicePointName       String?
  servicePointAddress    String?
  servicePointPostNumber String?

  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  /// Remboursement Stripe émis à l'annulation d'une commande payée.
  stripeRefundId        String?
  refundedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id])
  items         OrderItem[]
  shipment      Shipment?
  invoice       Invoice?
  creditNote    CreditNote?
  extraPayments ExtraPayment[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

enum DeliveryMode {
  HOME
  SERVICE_POINT
}

/// Expédition Sendcloud rattachée à une commande (un colis par commande).
model Shipment {
  id      String @id @default(cuid())
  orderId String @unique

  parcelId       String?
  trackingNumber String?
  trackingUrl    String?
  carrier        String?
  methodId       Int?
  methodName     String?
  weightGrams    Int
  labelPrinted   Boolean @default(false)
  statusId       Int?
  statusMessage  String?

  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Facture émise pour une commande payée. Le numéro est séquentiel par année.
model Invoice {
  id       String   @id @default(cuid())
  orderId  String   @unique
  number   String   @unique
  year     Int
  sequence Int
  issuedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([year, sequence])
  @@index([issuedAt])
}

/// Avoir émis à l'annulation d'une commande facturée : il annule la facture,
/// qui ne peut pas être supprimée. Numérotation séquentielle par année.
model CreditNote {
  id          String   @id @default(cuid())
  orderId     String   @unique
  number      String   @unique
  year        Int
  sequence    Int
  amountCents Int
  issuedAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([year, sequence])
}

/// Paiement complémentaire à montant libre (frais de réexpédition, correction
/// d'adresse…) : un lien Stripe est généré puis envoyé au client par e-mail.
model ExtraPayment {
  id          String             @id @default(cuid())
  orderId     String
  label       String
  amountCents Int
  currency    String             @default("EUR")
  status      ExtraPaymentStatus @default(PENDING)

  stripeSessionId String? @unique
  checkoutUrl     String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum ExtraPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  /// Taille commandée ; null pour les commandes antérieures à son enregistrement.
  size       String?
  quantity   Int
  priceCents Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SiteSettings {
  id              String   @id @default("singleton")
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model PageView {
  id          String   @id @default(cuid())
  day         String
  path        String
  referrer    String   @default("")
  deviceType  String   @default("desktop")
  country     String   @default("")
  duration    Int?
  visitorHash String
  createdAt   DateTime @default(now())

  @@index([day])
  @@index([day, path])
}

/// Compteur à fenêtre fixe des limites de débit (connexion, contact, checkout…).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Inscription en attente de vérification de l'e-mail. Le compte (User) n'est
/// créé qu'au clic sur le lien : l'inscription répond toujours pareil, que
/// l'adresse soit déjà inscrite ou non.
model PendingSignup {
  id           String   @id @default(cuid())
  email        String
  name         String
  passwordHash String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
}
