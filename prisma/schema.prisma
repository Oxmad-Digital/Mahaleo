// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cartItems  CartItem[]
  favorites  Favorite[]
  orders     Order[]
  passwordResetTokens PasswordResetToken[]
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  color       String?
  priceCents  Int
  currency    String   @default("EUR")
  onSale      Boolean  @default(false)
  salePriceCents Int?
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sizes      ProductSize[]
  cartItems  CartItem[]
  favorites  Favorite[]
  orderItems OrderItem[]
}

model ProductSize {
  id        String @id @default(cuid())
  productId String
  size      String
  stock     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String?
  status      OrderStatus @default(PENDING)
  totalCents  Int
  currency    String      @default("EUR")

  customerName  String
  customerEmail String
  phone         String?

  shippingAddress    String
  shippingCity       String
  shippingPostalCode String
  shippingCountry    String @default("FR")

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user          User?          @relation(fields: [userId], references: [id])
  items         OrderItem[]
  shipment      Shipment?
  invoice       Invoice?
  extraPayments ExtraPayment[]
}

/// Expédition Sendcloud rattachée à une commande (un colis par commande).
model Shipment {
  id      String @id @default(cuid())
  orderId String @unique

  parcelId       String?
  trackingNumber String?
  trackingUrl    String?
  carrier        String?
  methodId       Int?
  methodName     String?
  weightGrams    Int
  labelPrinted   Boolean @default(false)
  statusId       Int?
  statusMessage  String?

  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Facture émise pour une commande payée. Le numéro est séquentiel par année.
model Invoice {
  id       String   @id @default(cuid())
  orderId  String   @unique
  number   String   @unique
  year     Int
  sequence Int
  issuedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([year, sequence])
}

/// Paiement complémentaire à montant libre (frais de réexpédition, correction
/// d'adresse…) : un lien Stripe est généré puis envoyé au client par e-mail.
model ExtraPayment {
  id          String             @id @default(cuid())
  orderId     String
  label       String
  amountCents Int
  currency    String             @default("EUR")
  status      ExtraPaymentStatus @default(PENDING)

  stripeSessionId String? @unique
  checkoutUrl     String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum ExtraPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  priceCents Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SiteSettings {
  id              String   @id @default("singleton")
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model PageView {
  id          String   @id @default(cuid())
  day         String
  path        String
  referrer    String   @default("")
  deviceType  String   @default("desktop")
  country     String   @default("")
  duration    Int?
  visitorHash String
  createdAt   DateTime @default(now())

  @@index([day])
  @@index([day, path])
}
